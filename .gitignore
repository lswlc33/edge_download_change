# Build outputs and local tooling
lsp_module/build/
*.idsig
*.apk.idsig

# Signing keys are never committed: CI gets the key from the repository secrets
# (SIGNING_KEYSTORE_BASE64), local builds use lsp_module/module.keystore which you
# should back up - losing it means published updates can no longer be installed
# over the previous version.
*.keystore
*.jks

# Built module APKs are distributed through GitHub Releases, never committed
# (a stale committed APK once shadowed the fresh build in CI).
*.apk
*.apk.idsig

# Input APKs and extracted/derived analysis data
*.apks
apks_extracted/
dex/
*.dex

# Downloaded third-party APKs used for analysis
analysis/via/*.apk

# Extracted native libraries and other generated analysis output (stay on disk only)
so/
*.so
analysis/**/*.apk
analysis/**/*.dex
analysis/**/__pycache__/

# Generated analysis indexes and python cache (regenerable, keep the repo small)
analysis/*_index.txt
__pycache__/
analysis/__pycache__/

# IDE / OS noise
.idea/
*.iml
.gradle/
.DS_Store
Thumbs.db
*.log
